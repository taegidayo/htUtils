agent/agent.json
**/agent.json
# PC별 에이전트 로그인 토큰 (원래 %LOCALAPPDATA%·ProgramData에 있지만 복사돼 들어올 경우 대비)
identity.json
# Firebase 프로젝트 설정 (예시: web/config.example.js)
web/config.js
.firebaserc
# 서비스 계정 키 / 환경 변수 / 인증서
*-firebase-adminsdk-*.json
serviceAccount*.json
service-account*.json
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# --- 빌드 산출물 / 로그 / 캐시 ---
bin/
obj/
publish/
