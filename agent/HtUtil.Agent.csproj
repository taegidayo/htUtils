<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>HtUtil.Agent</AssemblyName>
    <Product>HtUtil Agent</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <!-- public config (apiKey, databaseUrl only) baked into the exe; build-agent.ps1 writes it without the TURN token.
         An agent.json next to the exe (TURN token) is merged over it. -->
    <!-- update signing public key (build-agent.ps1 writes it from keys\update-signing.key) -->
    <EmbeddedResource Include="update-signing.pub" LogicalName="update.pub" Condition="Exists('update-signing.pub')" />
    <EmbeddedResource Include="obj\agent.public.json" LogicalName="agent.json" Condition="Exists('obj\agent.public.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="10.0.4" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="agent.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
